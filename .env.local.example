# ============================================
# Supabase - קבל את הערכים מ-https://supabase.com/dashboard
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Service Role Key (רק בשרת! לעולם לא לחשוף בקליינט)
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ============================================
# OpenAI (אופציונלי - עבור AI Assistant)
# ============================================
OPENAI_API_KEY=sk-...

# ============================================
# Stripe - סליקה מאובטחת
# https://dashboard.stripe.com/apikeys
# ============================================
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# מקבל מ-Stripe CLI (stripe listen) או מהדשבורד אחרי הגדרת webhook
STRIPE_WEBHOOK_SECRET=whsec_...
# מטבע ברירת מחדל (ils, usd, eur וכו')
STRIPE_CURRENCY=ils

# ============================================
# Resend - מיילי אישור הזמנה
# https://resend.com/api-keys
# ============================================
RESEND_API_KEY=re_...
# אימייל שולח - חייב להיות דומיין מאומת ב-Resend
# ברירת מחדל onboarding@resend.dev עובד לבדיקות
RESEND_FROM_EMAIL=FashionStore <onboarding@resend.dev>
